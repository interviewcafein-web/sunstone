{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "sunstone-seven.vercel.app"
        }
      ],
      "destination": "https://vertex.sunstone.in/$1",
      "permanent": true
    },
    {
      "source": "/app/vertex.apk",
      "destination": "https://github.com/interviewcafein-web/sunstone/releases/latest/download/vertex.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug/card",
      "destination": "/api/share?slug=:slug&card=1"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-sheet",
      "schedule": "30 0 * * *"
    }
  ],
  "images": {
    "sizes": [64, 128],
    "formats": ["image/webp"],
    "minimumCacheTTL": 604800,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "d3s27eh1wskpwv.cloudfront.net"
      },
      {
        "protocol": "https",
        "hostname": "offer-letter-assets-bucket.s3.ap-south-1.amazonaws.com"
      }
    ]
  }
}
