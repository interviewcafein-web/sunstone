# Google Sheet that holds the student list (the long id in its URL).
# The sheet must be shared as "Anyone with the link can view".
# Read server-side only by api/students.ts; never sent to the browser.
SHEET_ID=
# Optional: tab id (the gid in the URL). Defaults to the first tab.
SHEET_GID=

# Staff logins (see api/_auth.ts). One entry per person, comma-separated; make each with
#   npm run hash-password -- <username> <password>
AUTH_USERS=
# Long random string that signs the login cookie; changing it logs everyone out.
AUTH_SECRET=

# Neon Postgres connection string (Neon console -> Connect, the pooled one). Read only by
# the functions in api/ and the sync scripts; never sent to the browser.
DATABASE_URL=

# Lets Vercel Cron call /api/sync-sheet each morning (copies new form answers onto
# students). Any long random string; Vercel sends it automatically once it is set.
CRON_SECRET=

# Passwordless staff sign-in. Who may sign in: `npm run staff -- add <email> "Name"` (stored
# in the database); STAFF_EMAILS can list extra comma-separated emails.
STAFF_EMAILS=
# Google sign-in: an OAuth client ("Web application") from Google Cloud Console, with
# https://<site>/api/auth/google-callback (and http://localhost:3002/api/auth/google-callback)
# as authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emailed sign-in codes, sent with Resend (https://resend.com) from a verified domain.
# Locally, without these, the code is printed in the dev server's terminal.
RESEND_API_KEY=
EMAIL_FROM=
