{
  "name": "sunstone",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hash-password": "node scripts/hash-password.mjs",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:import": "tsx --env-file=.env.local scripts/import-students.ts",
    "db:sync-sheet": "tsx --env-file=.env.local scripts/sync-sheet.ts",
    "staff": "tsx --env-file=.env.local scripts/staff.ts",
    "db:sync-assessments": "tsx --env-file=.env.local scripts/sync-assessments.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.71.5",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-router": "^1.130.12",
    "@vercel/og": "^0.8.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tanstack/eslint-plugin-query": "^5.71.5",
    "@tanstack/router-plugin": "^1.130.12",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "3.5.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.3.6"
  }
}
